{{!
    @template block_backadel/local/filter_panel

    Bootstrap 5 collapsible card containing injected filter form markup.

    Context variables:
    * collapseid - string, HTML id for the collapse element
    * title - toggle label
    * activecount - int (optional badge when > 0)
    * formhtml - raw form markup
    * expanded - bool, initial open state
}}
<div class="card mb-3 block_backadel_filter_panel">
    <div class="card-header p-0 bg-body">
        <button class="btn btn-outline-secondary w-100 text-start rounded-0"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#{{collapseid}}"
                aria-expanded="{{#expanded}}true{{/expanded}}{{^expanded}}false{{/expanded}}"
                aria-controls="{{collapseid}}">
            <span class="fw-semibold">{{title}}{{#activecount}}<span class="badge bg-primary ms-2">{{activecount}}</span>{{/activecount}}</span>
        </button>
    </div>
    <div id="{{collapseid}}" class="collapse{{#expanded}} show{{/expanded}}">
        <div class="card-body">
            {{{formhtml}}}
        </div>
    </div>
</div>
