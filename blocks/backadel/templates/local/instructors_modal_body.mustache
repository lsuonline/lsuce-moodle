{{!
    @template block_backadel/local/instructors_modal_body

    Modal body for the catalogue instructors list (username / full name).

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * hasrows - boolean, true when at least one instructor row exists
    * rows - array of row objects
    * rows.username - string, Moodle username
    * rows.fullname - string, user's full name
    * strings - object of pre-escaped UI labels from AMD init
    * strings.none - string, empty-state message
    * strings.colUsername - string, table column header
    * strings.colFullname - string, table column header

    Example context (json):
    {
        "hasrows": true,
        "rows": [
            {"username": "jdoe", "fullname": "Jane Doe"}
        ],
        "strings": {
            "none": "No instructors.",
            "colUsername": "Username",
            "colFullname": "Full name"
        }
    }
}}
{{#hasrows}}
<div class="block_backadel-modal-body">
    <table class="table table-sm">
        <thead>
            <tr>
                <th scope="col">{{strings.colUsername}}</th>
                <th scope="col">{{strings.colFullname}}</th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}
            <tr>
                <td>{{username}}</td>
                <td>{{fullname}}</td>
            </tr>
            {{/rows}}
        </tbody>
    </table>
</div>
{{/hasrows}}
{{^hasrows}}
<p class="text-muted">{{strings.none}}</p>
{{/hasrows}}
