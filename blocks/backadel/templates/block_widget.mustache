{{!
    @template block_backadel/block_widget

    Block sidebar widget — navigation links for the Backadel admin block.

    Context variables:
    * links - Array of navigation link objects.
    * links.iconhtml - Rendered pix_icon HTML.
    * links.url - Link href.
    * links.label - Link text.
    * links.count - Optional count badge (omit or null to hide).
    * links.countkey - Optional data-* selector hint: 'pending' or 'failed'.
    * statustext - Current job running status string.
    * statusiconhtml - Rendered pix_icon HTML for the status row.

    Example context (json):
    {
        "links": [
            {"iconhtml": "", "url": "/blocks/backadel/search.php", "label": "Backup", "count": null, "countkey": ""},
            {"iconhtml": "", "url": "/blocks/backadel/delete.php", "label": "Delete", "count": 3, "countkey": "pending"},
            {"iconhtml": "", "url": "/blocks/backadel/failed.php", "label": "Failures", "count": null, "countkey": "failed"}
        ],
        "statustext": "Not Running",
        "statusiconhtml": ""
    }
}}
<ul class="list-unstyled mb-0" data-backadel-widget>
{{#links}}
    <li>{{{iconhtml}}}<a href="{{url}}">{{label}}</a>{{#countkey}}<span {{#countkey}}data-backadel-{{countkey}}{{/countkey}} {{^count}}hidden{{/count}}>{{#count}} ({{count}}){{/count}}</span>{{/countkey}}{{^countkey}}{{#count}} ({{count}}){{/count}}{{/countkey}}</li>
{{/links}}
    <li>{{{statusiconhtml}}}<span data-backadel-status>{{statustext}}</span> <span data-backadel-spinner hidden aria-hidden="true" class="fa fa-spinner fa-spin fa-fw"></span></li>
</ul>
